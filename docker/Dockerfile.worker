FROM node:22-bookworm-slim
ARG CODEX_VERSION=0.160.0
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates php-cli php-mbstring php-mysql php-sqlite3 unzip && rm -rf /var/lib/apt/lists/* && npm install -g @openai/codex@${CODEX_VERSION}
COPY docker/worker-entrypoint.sh /usr/local/bin/worker-entrypoint
COPY docker/result.schema.json /opt/result.schema.json
RUN chmod 755 /usr/local/bin/worker-entrypoint && mkdir /workspace && chown 1000:1000 /workspace
ENV HOME=/home/codex CODEX_HOME=/home/codex/.codex
WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/worker-entrypoint"]
